# ==============================================================================
# Supabase PostgreSQL Database Configuration
# ==============================================================================
# Copy this file to .env.supabase and fill in your actual credentials.
# In Supabase: Project Settings -> Database -> Connection string -> URI / Parameters
# ==============================================================================

# Database host (e.g. db.xxxxxxxxxxxxxxxxxxxx.supabase.co or aws-0-us-east-1.pooler.supabase.com)
SUPABASE_DB_HOST=db.your-project-ref.supabase.co

# Database port (5432 for direct connection, 6543 for transaction/session pooler)
SUPABASE_DB_PORT=5432

# Database name (default in Supabase is postgres)
SUPABASE_DB_NAME=postgres

# Database user (default is postgres, or postgres.your-project-ref for connection pooler)
SUPABASE_DB_USER=postgres

# Database password
SUPABASE_DB_PASSWORD=your-supabase-db-password
